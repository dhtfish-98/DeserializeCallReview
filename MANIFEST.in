include 项目文档/LICENSE 项目文档/NOTICE 项目文档/README.md 项目文档/ORIGIN.md 项目文档/DEFENSIVE_SCOPE.md 项目文档/VALIDATION.md 项目文档/SOURCE_AUDIT.json requirements-dev.txt
recursive-include 项目文档/THIRD_PARTY_LICENSES *.txt
recursive-include src *.py py.typed
recursive-include tests *.py *.txt
recursive-include examples *.py
recursive-include scripts *.py
include .github/workflows/ci.yml
exclude .DS_Store
prune validation-local
prune .venv
prune .install-check
prune dist
prune build

# Current formal source inventory, including provenance and tests.
include .github/workflows/ci.yml
include .gitignore
include 项目文档/DEFENSIVE_SCOPE.md
include 项目文档/LICENSE
include 项目文档/NOTICE
include 项目文档/ORIGIN.md
include 项目文档/README.md
include 项目文档/SOURCE_AUDIT.json
include SOURCE_REVIEW_MANIFEST.json
include 项目文档/THIRD_PARTY_LICENSES/Bandit-Apache-2.0.txt
include 项目文档/VALIDATION.md
include examples/nominal_yaml_shape.py
include examples/open_dynamic_loader.py
include examples/selected_review.py
include pyproject.toml
include requirements-dev.txt
include scripts/installed_cli_check.py
include scripts/installed_smoke.py
include scripts/verify_package.py
include src/deserialize_call_review/__init__.py
include src/deserialize_call_review/__main__.py
include src/deserialize_call_review/analyzer.py
include src/deserialize_call_review/cli.py
include src/deserialize_call_review/files.py
include src/deserialize_call_review/py.typed
include tests/fixtures/upstream/pickle_deserialize.py.txt
include tests/fixtures/upstream/shelve_open.py.txt
include tests/fixtures/upstream/yaml_load.py.txt
include tests/test_bindings.py
include tests/test_boundaries.py
include tests/test_provenance.py
include tests/test_reader_capabilities.py
include tests/test_yaml.py

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE NOTICE ORIGIN.md README.md VALIDATION.md
