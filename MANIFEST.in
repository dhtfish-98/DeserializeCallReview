include LICENSE NOTICE README.md ORIGIN.md DEFENSIVE_SCOPE.md VALIDATION.md SOURCE_AUDIT.json requirements-dev.txt
recursive-include THIRD_PARTY_LICENSES *.txt
recursive-include src *.py py.typed
recursive-include tests *.py *.txt
recursive-include examples *.py
recursive-include scripts *.py
include .github/workflows/ci.yml
exclude .DS_Store
prune validation-local
prune .venv
prune .install-check
prune dist
prune build
